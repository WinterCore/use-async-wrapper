{
  "name": "use-async-wrapper",
  "version": "0.1.0",
  "description": "Typed async state and declarative rendering for React. Stop hand-writing if (isLoading) blocks.",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./react-query": {
      "types": "./dist/react-query.d.ts",
      "default": "./dist/react-query.js"
    }
  },
  "files": [
    "dist"
  ],
  "sideEffects": false,
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build"
  },
  "keywords": [
    "react",
    "async",
    "hooks",
    "loading",
    "error-handling",
    "stale-while-revalidate",
    "react-query",
    "async-data",
    "remote-data"
  ],
  "license": "MIT",
  "peerDependencies": {
    "@tanstack/react-query": "^5.0.0",
    "react": ">=18"
  },
  "peerDependenciesMeta": {
    "@tanstack/react-query": {
      "optional": true
    }
  },
  "devDependencies": {
    "@storybook/react-vite": "^10.5.7",
    "@tanstack/react-query": "^5.101.4",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "storybook": "^10.5.7",
    "typescript": "^7.0.2",
    "vite": "^8.2.1"
  }
}
